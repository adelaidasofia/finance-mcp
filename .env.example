# Copy to .env (chmod 600). Do NOT commit .env.

# Plaid credentials — get from https://dashboard.plaid.com after signup
PLAID_CLIENT_ID=
PLAID_SECRET=

# Plaid environment: sandbox | development | production
# - sandbox: fake credentials for testing (use test_user_good / pass_good in Link)
# - development: real banks, 100 free items, up to 1000 webhook events/mo
# - production: requires Plaid application + paid plan
PLAID_ENV=sandbox

# Vault path. Where finance-mcp writes Accounts.md / Investments.md / Cash Flow.md.
# Defaults to ~/Desktop/Adelaida Notes (the author's vault). Override for any user.
FINANCE_MCP_VAULT_PATH=

# Vault Finance folder (relative to vault root). Default: 🏠 Home/Finance
# Set blank to skip vault writes entirely.
FINANCE_MCP_FINANCE_FOLDER=🏠 Home/Finance

# Webhook URL (optional). For transaction-update notifications. Leave blank unless
# you've set up a public-facing webhook receiver.
PLAID_WEBHOOK_URL=

# Default currency for normalization. All balances normalized to this via FX.
FINANCE_MCP_BASE_CURRENCY=USD

# Audit log path. Default: ./audit.log inside the MCP folder.
FINANCE_MCP_AUDIT_LOG=audit.log

# SQLite data path. Default: ./data.db inside the MCP folder.
FINANCE_MCP_DB_PATH=data.db
